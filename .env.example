VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Calendar OAuth. The client ID is used in the frontend OAuth URL.
# The client secret is only ever read by netlify/functions/google-auth-callback.js
# (server-side) — never reference it from frontend code.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id
VITE_GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
